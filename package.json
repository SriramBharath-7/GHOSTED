{
  "name": "ghosted",
  "private": true,
  "version": "7.0.0-phase2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:setup": "npm run build:mobile && cap add android && cap sync android",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "build:mobile": "vite build --mode mobile",
    "test:mobile": "node --test tests/mobile-offline.test.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/core": "^8.0.0"
  }
}
